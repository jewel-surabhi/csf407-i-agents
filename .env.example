# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and MUST NOT be committed.

# --- LLM provider (Groq, OpenAI-compatible) ---
# Free API key: https://console.groq.com
GROQ_API_KEY=

# Model name and inference knobs.
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Runtime paths ---
IAGENT_DB_PATH=./iagent.db
IAGENT_RUNS_DIR=./data/runs

# --- Logging ---
LOG_LEVEL=INFO

# --- Test toggles ---
# Set to 1 to run epistemic tests against the live LLM instead of the recorded fake.
IAGENT_LIVE_LLM=0
